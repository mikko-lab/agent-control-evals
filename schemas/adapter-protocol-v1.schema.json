{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikko-lab/agent-control-evals/schemas/adapter-protocol-v1.schema.json",
  "title": "agent-control-evals adapter protocol v1 (one JSON object per line)",
  "$defs": {
    "harnessToAdapter": {
      "oneOf": [
        { "type": "object", "required": ["type", "protocol_version"], "additionalProperties": false, "properties": { "type": { "const": "hello" }, "protocol_version": { "const": 1 } } },
        { "type": "object", "required": ["type", "protocol_version", "case"], "additionalProperties": false, "properties": { "type": { "const": "case" }, "protocol_version": { "const": 1 }, "case": { "allOf": [{ "$ref": "case.schema.json" }, { "not": { "required": ["expected"] } }], "description": "The oracle expectation is never sent to an adapter." } } },
        { "type": "object", "required": ["type", "protocol_version"], "additionalProperties": false, "properties": { "type": { "const": "shutdown" }, "protocol_version": { "const": 1 } } }
      ]
    },
    "helloResponse": {
      "type": "object",
      "required": ["type", "protocol_version", "adapter", "adapter_version", "sut"],
      "properties": {
        "type": { "const": "hello" },
        "protocol_version": { "const": 1 },
        "adapter": { "type": "string" },
        "adapter_version": { "type": "string" },
        "sut": { "type": "object", "required": ["name", "commit", "version", "worktree_clean"], "properties": { "commit": { "type": "string" }, "worktree_clean": { "type": "boolean" } } }
      }
    },
    "observedAssertion": {
      "type": "object",
      "required": ["step", "stage", "outcome", "reason_class", "sut_reason_code", "enforcement_stage"],
      "properties": {
        "step": { "type": "integer", "minimum": 0 },
        "attempt": { "type": "integer", "minimum": 0 },
        "stage": { "enum": ["request", "approval", "result", "verifier", "permit"] },
        "outcome": { "enum": ["ALLOW", "ASK", "DENY", "EXECUTE", "REJECT", "DELIVER", "WITHHOLD", "ACCEPT", "EXECUTE_ONCE", "REUSE_BLOCKED", "REUSE_ACCEPTED"] },
        "reason_class": { "type": "string", "pattern": "^[A-Z_]+$" },
        "sut_reason_code": { "type": "string" },
        "enforcement_stage": { "type": "string" }
      }
    },
    "caseResult": {
      "type": "object",
      "required": ["type", "case_id", "protocol_version", "evaluation_boundary", "status", "observations", "raw_sut_evidence"],
      "properties": {
        "type": { "const": "case_result" },
        "case_id": { "type": "string" },
        "protocol_version": { "const": 1 },
        "evaluation_boundary": { "enum": ["runtime", "component"] },
        "status": { "enum": ["ok", "adapter_error"] },
        "observations": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["assertions", "executions", "unattributed_executions"],
              "properties": {
                "assertions": { "type": "array", "items": { "$ref": "#/$defs/observedAssertion" } },
                "executions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
                "unattributed_executions": { "type": "integer", "minimum": 0 },
                "permit_reuses_accepted": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        "raw_sut_evidence": {},
        "error": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" } } }
      },
      "if": { "properties": { "status": { "const": "adapter_error" } } },
      "then": { "required": ["error"], "properties": { "observations": { "type": "null" } } },
      "else": { "properties": { "observations": { "type": "object" } } }
    }
  }
}
