{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "observation_source",
    "corpus_sha256",
    "counts",
    "technically_valid",
    "has_confirmed_violation",
    "all_required_assessed",
    "acceptance_passed",
    "limitations",
    "evidence"
  ],
  "properties": {
    "version": {
      "const": "revocation-0.4.0"
    },
    "observation_source": {
      "enum": [
        "synthetic_harness_trace",
        "external_adapter_declared_unverified"
      ]
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PASS",
        "VIOLATION",
        "UNASSESSABLE",
        "HARNESS_ERROR",
        "assessed",
        "total",
        "confirmed_violation_cases"
      ],
      "properties": {
        "PASS": {
          "type": "integer",
          "minimum": 0
        },
        "VIOLATION": {
          "type": "integer",
          "minimum": 0
        },
        "UNASSESSABLE": {
          "type": "integer",
          "minimum": 0
        },
        "HARNESS_ERROR": {
          "type": "integer",
          "minimum": 0
        },
        "assessed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_violation_cases": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "technically_valid": {
      "type": "boolean"
    },
    "has_confirmed_violation": {
      "type": "boolean"
    },
    "all_required_assessed": {
      "type": "boolean"
    },
    "acceptance_passed": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "family",
          "state_at_cut",
          "verdict",
          "confirmed_violation",
          "decision_findings",
          "effect_findings",
          "incomplete",
          "errors"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": [
              "pending_approval",
              "issued_permit",
              "active_session",
              "in_flight_before_commit",
              "in_flight_after_commit",
              "descendant_scope",
              "scope_isolation",
              "identity",
              "observation_timing",
              "control"
            ]
          },
          "state_at_cut": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step",
                "target",
                "authorities"
              ],
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 0
                },
                "target": {
                  "$ref": "#/$defs/target"
                },
                "authorities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "grant",
                      "revoked",
                      "executions"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "grant": {
                        "enum": [
                          "pending",
                          "approved",
                          "issued",
                          "consumed"
                        ]
                      },
                      "revoked": {
                        "enum": [
                          "before_cut",
                          "by_cut",
                          "no"
                        ]
                      },
                      "executions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "phase"
                          ],
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "phase": {
                              "enum": [
                                "running",
                                "committed",
                                "delivered",
                                "finish_requested"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "verdict": {
            "enum": [
              "PASS",
              "VIOLATION",
              "UNASSESSABLE",
              "HARNESS_ERROR"
            ]
          },
          "confirmed_violation": {
            "type": "boolean"
          },
          "decision_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step",
                "reason"
              ],
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 0
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "effect_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step",
                "reason"
              ],
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 0
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "incomplete": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "path",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "id"
          ],
          "properties": {
            "scope": {
              "const": "authority"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "tenant",
            "session"
          ],
          "properties": {
            "scope": {
              "const": "session"
            },
            "tenant": {
              "type": "string",
              "minLength": 1
            },
            "session": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "tenant"
          ],
          "properties": {
            "scope": {
              "const": "tenant"
            },
            "tenant": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
