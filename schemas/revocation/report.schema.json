{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "observation_source",
    "corpus_sha256",
    "counts",
    "all_required_assessed",
    "acceptance_passed",
    "limitations",
    "evidence"
  ],
  "properties": {
    "version": {
      "const": "revocation-0.1.0"
    },
    "observation_source": {
      "enum": [
        "synthetic_harness_trace",
        "external_adapter_declared_unverified"
      ]
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PASS",
        "VIOLATION",
        "UNASSESSABLE",
        "HARNESS_ERROR",
        "assessed",
        "total"
      ],
      "properties": {
        "PASS": {
          "type": "integer",
          "minimum": 0
        },
        "VIOLATION": {
          "type": "integer",
          "minimum": 0
        },
        "UNASSESSABLE": {
          "type": "integer",
          "minimum": 0
        },
        "HARNESS_ERROR": {
          "type": "integer",
          "minimum": 0
        },
        "assessed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "all_required_assessed": {
      "type": "boolean"
    },
    "acceptance_passed": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "stage",
          "verdict",
          "decision_findings",
          "effect_findings",
          "incomplete",
          "errors"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "pending",
              "issued",
              "active",
              "in_flight",
              "committed"
            ]
          },
          "verdict": {
            "enum": [
              "PASS",
              "VIOLATION",
              "UNASSESSABLE",
              "HARNESS_ERROR"
            ]
          },
          "decision_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step",
                "reason"
              ],
              "properties": {
                "step": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "effect_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step",
                "reason"
              ],
              "properties": {
                "step": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "incomplete": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
