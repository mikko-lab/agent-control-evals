{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "revocation-0.4.0 pinned-runtime-adapter observation, format revision 3 (tenancy-mode runtime with the opt-in approval-permit lifecycle, permit mode; approval-permit lifecycle plan sections 7.1-7.2). Formats 1 and 2 are unchanged. Revision 3 adds: the identity mapping's lineages (runtime lineage_id -> contract authority); the setup_baseline probe point; per probe the lineage snapshots (states, *_seq, permit and execution ids, bindings; no timestamps) and the shared authority sequence value; per execution record the runtime's request_id; the lifecycle call APIs approve, issuePermit and start (process and resolveApproval are not step calls in permit mode); per call the lifecycle denial reason and the start request id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "case_id",
    "complete",
    "decisions",
    "effects",
    "identity",
    "probes",
    "calls",
    "diagnostics"
  ],
  "properties": {
    "format": {
      "const": "revocation-runtime-observation/3"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "complete": {
      "type": "boolean"
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "sessions",
        "tenants",
        "chains",
        "lineages"
      ],
      "properties": {
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "sessions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tenant",
              "session"
            ],
            "properties": {
              "tenant": {
                "type": "string",
                "minLength": 1
              },
              "session": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "tenants": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "chains": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "lineages": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "step",
          "point",
          "state"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "point": {
            "enum": [
              "setup_baseline",
              "pre_action",
              "tool_entry",
              "event",
              "barrier_complete",
              "seal_settle"
            ]
          },
          "state": {
            "$ref": "#/$defs/state"
          }
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "api",
          "outcome"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "api": {
            "enum": [
              "revoke",
              "approve",
              "issuePermit",
              "start",
              "commit",
              "deliver",
              "acknowledgeCancellation"
            ]
          },
          "outcome": {
            "enum": [
              "returned",
              "threw",
              "tool_invoked",
              "fulfilled",
              "rejected",
              "timeout"
            ]
          },
          "class": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "code",
          "detail"
        ],
        "properties": {
          "step": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "id"
          ],
          "properties": {
            "scope": {
              "const": "authority"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "tenant",
            "session"
          ],
          "properties": {
            "scope": {
              "const": "session"
            },
            "tenant": {
              "type": "string",
              "minLength": 1
            },
            "session": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "tenant"
          ],
          "properties": {
            "scope": {
              "const": "tenant"
            },
            "tenant": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "decision",
        "provenance"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "decision": {
          "enum": [
            "ALLOW",
            "DENY",
            "UNKNOWN"
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sut_api",
              "sut_state",
              "harness_observation"
            ]
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "kind",
        "authority",
        "execution",
        "target",
        "seq",
        "provenance"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "approval_granted",
            "permit_issued",
            "execution_started",
            "tool_commit",
            "output_delivery",
            "revocation_ack",
            "cancellation_ack",
            "execution_terminal"
          ]
        },
        "authority": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "execution": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "target": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/target"
            }
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sut_api",
              "sut_state",
              "harness_observation"
            ]
          }
        }
      }
    },
    "runtime_target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "capability_id"
          ],
          "properties": {
            "scope": {
              "const": "capability"
            },
            "capability_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "session_id"
          ],
          "properties": {
            "scope": {
              "const": "session"
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "tenant_id"
          ],
          "properties": {
            "scope": {
              "const": "tenant"
            },
            "tenant_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipts",
        "entries",
        "executions",
        "terminals",
        "managed",
        "managed_version",
        "deliveries",
        "lineages",
        "authority_seq"
      ],
      "properties": {
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "target"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 0
              },
              "target": {
                "$ref": "#/$defs/runtime_target"
              }
            }
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "execution_id",
              "request_authority"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "execution_id": {
                "type": "string",
                "minLength": 1
              },
              "request_authority": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "executions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "execution_id",
              "capability_id",
              "session_id",
              "state",
              "cancellation_acknowledged",
              "terminal",
              "tenant_id",
              "ancestor_capability_ids",
              "request_id"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "execution_id": {
                "type": "string",
                "minLength": 1
              },
              "capability_id": {
                "type": "string",
                "minLength": 1
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "minLength": 1
              },
              "cancellation_acknowledged": {
                "type": "boolean"
              },
              "terminal": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "execution_id",
                      "outcome"
                    ],
                    "properties": {
                      "execution_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "outcome": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "tenant_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "ancestor_capability_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "request_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "managed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "n",
              "value_json"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "value_json": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          }
        },
        "deliveries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "terminals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "execution_id",
              "outcome"
            ],
            "properties": {
              "execution_id": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "managed_version": {
          "type": "integer",
          "minimum": 0
        },
        "authority_seq": {
          "type": "integer",
          "minimum": 0
        },
        "lineages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lineage_id",
              "state",
              "approval_state",
              "approver_type",
              "created_seq",
              "approved_seq",
              "permit_state",
              "permit_id",
              "issued_seq",
              "consumed_seq",
              "execution_id",
              "start_request_id",
              "capability_id",
              "ancestor_capability_ids",
              "session_id",
              "tenant_id",
              "agent_id",
              "tool",
              "arguments_digest",
              "request_id",
              "request_digest"
            ],
            "properties": {
              "lineage_id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "pending",
                  "approved",
                  "issued",
                  "consumed",
                  "rejected",
                  "approval_expired",
                  "permit_expired"
                ]
              },
              "approval_state": {
                "enum": [
                  "pending",
                  "approved",
                  "rejected",
                  "expired"
                ]
              },
              "approver_type": {
                "type": "string",
                "minLength": 1
              },
              "created_seq": {
                "type": "integer",
                "minimum": 0
              },
              "approved_seq": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "permit_state": {
                "enum": [
                  "none",
                  "issued",
                  "consumed",
                  "expired"
                ]
              },
              "permit_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "issued_seq": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "consumed_seq": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "execution_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "start_request_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "capability_id": {
                "type": "string",
                "minLength": 1
              },
              "ancestor_capability_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "tenant_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "agent_id": {
                "type": "string",
                "minLength": 1
              },
              "tool": {
                "type": "string",
                "minLength": 1
              },
              "arguments_digest": {
                "type": "string",
                "minLength": 1
              },
              "request_id": {
                "type": "string",
                "minLength": 1
              },
              "request_digest": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
