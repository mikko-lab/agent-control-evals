{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikko-lab/agent-control-evals/schemas/report.schema.json",
  "title": "agent-control-evals report",
  "description": "Versioned evaluation report (schema 0.4.0). Runtime and component results are separate; there is no combined security score. Confidence bounds are scenario-level only; assertion counts are descriptive; breadth is variant coverage; decision/effect integrity is reported separately from oracle-based metrics, without confidence bounds. Since 0.4.0, integrity authority decisions come only from SUT authority evidence, every category has its own eligible set, and decisions not observed / ambiguous / unavailable observations are reported separately and excluded from clean denominators.",
  "type": "object",
  "required": [
    "report_schema_version",
    "profile",
    "full_benchmark_executed",
    "headline",
    "gates",
    "manifest",
    "control_matrix",
    "na_controls",
    "reason_taxonomy",
    "harness_validity",
    "oracle_independence_check",
    "adapter_validation",
    "mutation_reachability",
    "runtime_metrics",
    "component_metrics",
    "statistical_bounds",
    "mutation_sensitivity",
    "findings",
    "adapter_errors",
    "harness_errors",
    "oracle_limitation",
    "limitations",
    "decision_effect_integrity"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|unknown)$"
    },
    "boundary": {
      "enum": [
        "runtime",
        "component"
      ]
    },
    "rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "bound": {
      "type": "object",
      "required": [
        "unit",
        "k",
        "n",
        "observed_rate",
        "one_sided_95_upper_bound",
        "rule_of_three",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "scenario"
        },
        "k": {
          "type": "integer",
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "observed_rate": {
          "$ref": "#/$defs/rate"
        },
        "one_sided_95_upper_bound": {
          "$ref": "#/$defs/rate"
        },
        "rule_of_three": {
          "$ref": "#/$defs/rate"
        },
        "method": {
          "const": "clopper-pearson-exact-one-sided"
        }
      }
    },
    "metricBlock": {
      "type": "object",
      "required": [
        "scenario_counts",
        "descriptive_assertion_counts",
        "invariants",
        "exact_assertion_match_rate",
        "scenario_bounds"
      ],
      "additionalProperties": false,
      "properties": {
        "scenario_counts": {
          "$ref": "#/$defs/scenarioCounts"
        },
        "descriptive_assertion_counts": {
          "$ref": "#/$defs/assertionCounts"
        },
        "invariants": {
          "$ref": "#/$defs/invariantCounts"
        },
        "exact_assertion_match_rate": {
          "$ref": "#/$defs/rate"
        },
        "scenario_bounds": {
          "type": "object",
          "required": [
            "scenario_outcome_mismatch",
            "false_allow",
            "false_deny",
            "bypass"
          ],
          "additionalProperties": false,
          "properties": {
            "scenario_outcome_mismatch": {
              "$ref": "#/$defs/bound"
            },
            "false_allow": {
              "$ref": "#/$defs/bound"
            },
            "false_deny": {
              "$ref": "#/$defs/bound"
            },
            "bypass": {
              "$ref": "#/$defs/bound"
            }
          }
        }
      }
    },
    "boundaryMetrics": {
      "type": "object",
      "required": [
        "boundary",
        "evaluated_cases",
        "variant_coverage",
        "total",
        "family_macro_average",
        "by_family"
      ],
      "properties": {
        "boundary": {
          "$ref": "#/$defs/boundary"
        },
        "evaluated_cases": {
          "type": "integer",
          "minimum": 0
        },
        "variant_coverage": {
          "$ref": "#/$defs/variantCoverage"
        },
        "total": {
          "$ref": "#/$defs/metricBlock"
        },
        "by_family": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "scenario_counts",
              "descriptive_assertion_counts",
              "invariants",
              "exact_assertion_match_rate",
              "scenario_bounds",
              "variant_coverage",
              "by_variant"
            ],
            "properties": {
              "scenario_bounds": {
                "$ref": "#/$defs/metricBlock/properties/scenario_bounds"
              },
              "variant_coverage": {
                "$ref": "#/$defs/variantCoverage"
              },
              "by_variant": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/metricBlock"
                }
              }
            }
          }
        }
      }
    },
    "mutantResult": {
      "type": "object",
      "required": [
        "mutation_id",
        "family",
        "evaluation_boundary",
        "status",
        "invalid_reason",
        "witness_candidates",
        "baseline_valid_witness_candidates",
        "witness_case_ids",
        "witness_count",
        "mutant_adapter_errors",
        "outcome_mismatches_by_boundary",
        "boundary_violation",
        "integrity_scenarios"
      ],
      "properties": {
        "evaluation_boundary": {
          "$ref": "#/$defs/boundary"
        },
        "status": {
          "enum": [
            "killed",
            "survived",
            "invalid"
          ]
        },
        "witness_case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "errorRecord": {
      "type": "object",
      "required": [
        "case_id",
        "kind",
        "message"
      ],
      "properties": {
        "kind": {
          "enum": [
            "adapter_error",
            "harness_error",
            "protocol_error"
          ]
        }
      }
    },
    "scenarioCounts": {
      "type": "object",
      "required": [
        "cases",
        "adversarial_cases",
        "cases_with_restrictive_expectation",
        "cases_with_permissive_primary",
        "cases_outcome_match",
        "cases_exact_match",
        "false_allow_cases",
        "false_deny_cases",
        "bypass_cases",
        "permissive_deviation_outside_denominator",
        "decision_effect_mismatch_cases"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "assertionCounts": {
      "type": "object",
      "description": "Descriptive only; no bounds.",
      "required": [
        "assertions_evaluated",
        "assertions_matched",
        "assertions_outcome_matched",
        "false_allow_mismatches",
        "false_deny_mismatches",
        "decision_effect_mismatches",
        "expected_ask",
        "ask_to_ask",
        "ask_to_allow",
        "ask_to_deny",
        "allow_to_ask",
        "deny_to_ask"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "invariantCounts": {
      "type": "object",
      "required": [
        "duplicate_executions",
        "unexpected_executions",
        "cross_request_executions",
        "cross_session_executions",
        "unexpected_deliveries",
        "permit_reuses_accepted"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "variantCoverage": {
      "type": "object",
      "required": [
        "variants",
        "adversarial_variants",
        "positive_variants",
        "variants_with_outcome_failure",
        "adversarial_variants_with_bypass",
        "positive_variants_with_false_deny",
        "mean_cases_per_variant"
      ],
      "additionalProperties": false,
      "properties": {
        "variants": {
          "type": "integer",
          "minimum": 0
        },
        "adversarial_variants": {
          "type": "integer",
          "minimum": 0
        },
        "positive_variants": {
          "type": "integer",
          "minimum": 0
        },
        "variants_with_outcome_failure": {
          "type": "integer",
          "minimum": 0
        },
        "adversarial_variants_with_bypass": {
          "type": "integer",
          "minimum": 0
        },
        "positive_variants_with_false_deny": {
          "type": "integer",
          "minimum": 0
        },
        "mean_cases_per_variant": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "headlineBoundary": {
      "type": "object",
      "required": [
        "scenario_mismatches",
        "scenarios",
        "variants",
        "adversarial_variants",
        "variants_with_outcome_failure",
        "assertion_mismatches_descriptive",
        "assertions_descriptive"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "integrityCategory": {
      "type": "object",
      "required": [
        "count",
        "eligible_scenarios",
        "excluded_scenarios",
        "eligible_definition",
        "rate_descriptive",
        "confidence_bound",
        "case_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_scenarios": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_scenarios": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_definition": {
          "type": "string",
          "minLength": 1
        },
        "rate_descriptive": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence_bound": {
          "const": "not_applicable"
        },
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "integrityBoundary": {
      "type": "object",
      "required": [
        "boundary",
        "evaluated_scenarios",
        "scenarios_with_effect_channel",
        "decision_points",
        "unauthorized_execution",
        "unauthorized_delivery",
        "missing_expected_effect",
        "decision_effect_mismatch",
        "decision_not_observed",
        "ambiguous_effect_observation",
        "unavailable_effect_observation",
        "evidence_sources",
        "by_family"
      ],
      "additionalProperties": false,
      "properties": {
        "boundary": {
          "$ref": "#/$defs/boundary"
        },
        "evaluated_scenarios": {
          "type": "integer",
          "minimum": 0
        },
        "scenarios_with_effect_channel": {
          "type": "integer",
          "minimum": 0
        },
        "decision_points": {
          "type": "integer",
          "minimum": 0
        },
        "unauthorized_execution": {
          "$ref": "#/$defs/integrityCategory"
        },
        "unauthorized_delivery": {
          "$ref": "#/$defs/integrityCategory"
        },
        "missing_expected_effect": {
          "$ref": "#/$defs/integrityCategory"
        },
        "decision_effect_mismatch": {
          "$ref": "#/$defs/integrityCategory"
        },
        "decision_not_observed": {
          "$ref": "#/$defs/integrityCategory"
        },
        "ambiguous_effect_observation": {
          "$ref": "#/$defs/integrityCategory"
        },
        "unavailable_effect_observation": {
          "$ref": "#/$defs/integrityCategory"
        },
        "evidence_sources": {
          "type": "object",
          "required": [
            "authority",
            "result_control",
            "execution",
            "delivery"
          ],
          "additionalProperties": false,
          "properties": {
            "authority": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "result_control": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "execution": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "delivery": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "by_family": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "scenarios",
              "unauthorized_execution",
              "unauthorized_delivery",
              "missing_expected_effect",
              "decision_effect_mismatch",
              "decision_not_observed",
              "ambiguous_effect_observation",
              "unavailable_effect_observation"
            ],
            "properties": {
              "scenarios": {
                "type": "integer",
                "minimum": 0
              },
              "unauthorized_execution": {
                "type": "object",
                "required": [
                  "count",
                  "eligible_scenarios"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "eligible_scenarios": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "unauthorized_delivery": {
                "type": "object",
                "required": [
                  "count",
                  "eligible_scenarios"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "eligible_scenarios": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "missing_expected_effect": {
                "type": "object",
                "required": [
                  "count",
                  "eligible_scenarios"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "eligible_scenarios": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "decision_effect_mismatch": {
                "type": "object",
                "required": [
                  "count",
                  "eligible_scenarios"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "eligible_scenarios": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "decision_not_observed": {
                "type": "object",
                "required": [
                  "count",
                  "eligible_scenarios"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "eligible_scenarios": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "ambiguous_effect_observation": {
                "type": "object",
                "required": [
                  "count",
                  "eligible_scenarios"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "eligible_scenarios": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "unavailable_effect_observation": {
                "type": "object",
                "required": [
                  "count",
                  "eligible_scenarios"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "eligible_scenarios": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "report_schema_version": {
      "const": "0.4.0"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "full_benchmark_executed": {
      "type": "boolean"
    },
    "headline": {
      "type": "object",
      "required": [
        "sut_commit",
        "harness_version",
        "harness_commit",
        "corpus_profile",
        "corpus_sha256",
        "generator_version",
        "oracle_spec_version",
        "mutation_set_version",
        "families",
        "runtime",
        "component",
        "mutation"
      ],
      "properties": {
        "sut_commit": {
          "$ref": "#/$defs/commit"
        },
        "harness_commit": {
          "$ref": "#/$defs/commit"
        },
        "corpus_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime": {
          "$ref": "#/$defs/headlineBoundary"
        },
        "component": {
          "$ref": "#/$defs/headlineBoundary"
        }
      }
    },
    "gates": {
      "type": "object",
      "required": [
        "harness_valid",
        "harness_validity_problems",
        "mutation_gate_passed",
        "mutation_gate_failures",
        "baseline_findings"
      ],
      "properties": {
        "harness_valid": {
          "type": "boolean"
        },
        "mutation_gate_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "baseline_findings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "generator_version",
        "oracle_spec_version",
        "mutation_set_version",
        "seed",
        "cases",
        "cases_per_boundary",
        "cases_per_family",
        "cases_per_variant",
        "corpus_sha256",
        "adapter_protocol",
        "adapter_version",
        "sut",
        "sut_repository",
        "sut_commit",
        "sut_version",
        "harness_version",
        "harness_commit",
        "report_schema_version"
      ],
      "properties": {
        "corpus_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sut_commit": {
          "$ref": "#/$defs/commit"
        },
        "adapter_protocol": {
          "const": 1
        }
      }
    },
    "control_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control",
          "evaluation_boundary",
          "status"
        ],
        "properties": {
          "evaluation_boundary": {
            "enum": [
              "runtime",
              "component",
              "N/A"
            ]
          },
          "status": {
            "enum": [
              "measured",
              "N/A"
            ]
          }
        }
      }
    },
    "na_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control",
          "evaluation_boundary",
          "status",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "control": {
            "type": "string"
          },
          "evaluation_boundary": {
            "const": "N/A"
          },
          "status": {
            "const": "N/A"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "reason_taxonomy": {
      "type": "object",
      "required": [
        "version",
        "classes"
      ]
    },
    "harness_validity": {
      "type": "object",
      "required": [
        "valid",
        "problems",
        "corpus_determinism",
        "golden",
        "sut_checkout",
        "sut_self_verification",
        "observation_determinism"
      ]
    },
    "oracle_independence_check": {
      "type": "object",
      "required": [
        "ok",
        "static_dependency_check",
        "expectations_precomputed_before_sut_run",
        "expected_never_sent_to_adapter",
        "stored_expectation_integrity_errors"
      ]
    },
    "adapter_validation": {
      "type": "object",
      "required": [
        "hello",
        "cases_sent",
        "results_received",
        "adapter_errors",
        "harness_errors"
      ]
    },
    "mutation_reachability": {
      "type": "object",
      "required": [
        "all_ok",
        "mutants"
      ]
    },
    "runtime_metrics": {
      "allOf": [
        {
          "$ref": "#/$defs/boundaryMetrics"
        },
        {
          "properties": {
            "boundary": {
              "const": "runtime"
            }
          }
        }
      ]
    },
    "component_metrics": {
      "allOf": [
        {
          "$ref": "#/$defs/boundaryMetrics"
        },
        {
          "properties": {
            "boundary": {
              "const": "component"
            }
          }
        }
      ]
    },
    "statistical_bounds": {
      "type": "object",
      "required": [
        "disclaimer",
        "method",
        "unit",
        "sampling_model",
        "breadth_caveat",
        "entries"
      ],
      "properties": {
        "disclaimer": {
          "const": "Confidence bounds are conditional on the declared synthetic corpus sampling model. They are not estimates of the real-world probability that the system will fail in production."
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "boundary",
              "scope",
              "metric",
              "unit",
              "k",
              "n",
              "observed_rate",
              "one_sided_95_upper_bound"
            ],
            "properties": {
              "boundary": {
                "$ref": "#/$defs/boundary"
              },
              "unit": {
                "const": "scenario"
              }
            }
          }
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "mutation_sensitivity": {
      "type": "object",
      "required": [
        "executed",
        "runtime",
        "component",
        "by_mutant",
        "by_family",
        "witness_cases"
      ],
      "properties": {
        "by_mutant": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutantResult"
          }
        }
      }
    },
    "findings": {
      "type": "array"
    },
    "adapter_errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/errorRecord"
      }
    },
    "harness_errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/errorRecord"
      }
    },
    "oracle_limitation": {
      "const": "The generator, oracle specification and mutation set are human-authored and may share conceptual blind spots. The evaluation demonstrates conformance to the declared evaluation specification, not absolute real-world safety."
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5
    },
    "decision_effect_integrity": {
      "type": "object",
      "required": [
        "definitions",
        "authority_sources",
        "separation_from_oracle_metrics",
        "unit",
        "confidence_bound",
        "confidence_bound_reason",
        "runtime",
        "component"
      ],
      "properties": {
        "confidence_bound": {
          "const": "not_applicable"
        },
        "runtime": {
          "allOf": [
            {
              "$ref": "#/$defs/integrityBoundary"
            },
            {
              "properties": {
                "boundary": {
                  "const": "runtime"
                }
              }
            }
          ]
        },
        "component": {
          "allOf": [
            {
              "$ref": "#/$defs/integrityBoundary"
            },
            {
              "properties": {
                "boundary": {
                  "const": "component"
                }
              }
            }
          ]
