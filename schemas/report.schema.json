{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikko-lab/agent-control-evals/schemas/report.schema.json",
  "title": "agent-control-evals report",
  "description": "Versioned evaluation report. Runtime and component results are separate; there is no combined security score.",
  "type": "object",
  "required": [
    "report_schema_version", "profile", "full_benchmark_executed", "headline", "gates", "manifest", "control_matrix", "na_controls",
    "reason_taxonomy", "harness_validity", "oracle_independence_check", "adapter_validation", "mutation_reachability",
    "runtime_metrics", "component_metrics", "statistical_bounds", "mutation_sensitivity", "findings",
    "adapter_errors", "harness_errors", "oracle_limitation", "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^([0-9a-f]{40}|unknown)$" },
    "boundary": { "enum": ["runtime", "component"] },
    "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "bound": {
      "type": "object",
      "required": ["k", "n", "observed_rate", "one_sided_95_upper_bound", "rule_of_three", "method"],
      "additionalProperties": false,
      "properties": {
        "k": { "type": "integer", "minimum": 0 },
        "n": { "type": "integer", "minimum": 0 },
        "observed_rate": { "$ref": "#/$defs/rate" },
        "one_sided_95_upper_bound": { "$ref": "#/$defs/rate" },
        "rule_of_three": { "$ref": "#/$defs/rate" },
        "method": { "const": "clopper-pearson-exact-one-sided" }
      }
    },
    "counts": {
      "type": "object",
      "required": ["cases", "adversarial_cases", "assertions_evaluated", "assertions_matched", "assertions_outcome_matched", "false_allow", "false_deny", "expected_ask", "ask_to_ask", "ask_to_allow", "ask_to_deny", "allow_to_ask", "deny_to_ask", "bypasses", "invariants"],
      "properties": {
        "invariants": {
          "type": "object",
          "required": ["duplicate_executions", "unexpected_executions", "cross_request_executions", "cross_session_executions", "unexpected_deliveries", "permit_reuses_accepted"]
        }
      }
    },
    "metricBlock": {
      "type": "object",
      "required": ["counts", "exact_oracle_match_rate", "bounds"],
      "properties": {
        "counts": { "$ref": "#/$defs/counts" },
        "exact_oracle_match_rate": { "$ref": "#/$defs/rate" },
        "bounds": {
          "type": "object",
          "required": ["oracle_mismatch", "false_allow", "false_deny", "bypass"],
          "additionalProperties": { "$ref": "#/$defs/bound" }
        }
      }
    },
    "boundaryMetrics": {
      "type": "object",
      "required": ["boundary", "evaluated_cases", "total", "family_macro_average", "by_family"],
      "properties": {
        "boundary": { "$ref": "#/$defs/boundary" },
        "evaluated_cases": { "type": "integer", "minimum": 0 },
        "total": { "$ref": "#/$defs/metricBlock" },
        "by_family": {
          "type": "object",
          "additionalProperties": {
            "allOf": [{ "$ref": "#/$defs/metricBlock" }, { "type": "object", "required": ["by_variant"], "properties": { "by_variant": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metricBlock" } } } }]
          }
        }
      }
    },
    "mutantResult": {
      "type": "object",
      "required": ["mutation_id", "family", "evaluation_boundary", "status", "invalid_reason", "witness_candidates", "baseline_valid_witness_candidates", "witness_case_ids", "witness_count", "mutant_adapter_errors", "outcome_mismatches_by_boundary", "boundary_violation"],
      "properties": {
        "evaluation_boundary": { "$ref": "#/$defs/boundary" },
        "status": { "enum": ["killed", "survived", "invalid"] },
        "witness_case_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "errorRecord": {
      "type": "object",
      "required": ["case_id", "kind", "message"],
      "properties": { "kind": { "enum": ["adapter_error", "harness_error", "protocol_error"] } }
    }
  },
  "properties": {
    "report_schema_version": { "const": "0.1.0" },
    "profile": { "enum": ["smoke", "full"] },
    "full_benchmark_executed": { "type": "boolean" },
    "headline": {
      "type": "object",
      "required": ["sut_commit", "harness_version", "harness_commit", "corpus_profile", "corpus_sha256", "generator_version", "oracle_spec_version", "mutation_set_version", "families", "runtime", "component", "mutation"],
      "properties": {
        "sut_commit": { "$ref": "#/$defs/commit" },
        "harness_commit": { "$ref": "#/$defs/commit" },
        "corpus_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gates": {
      "type": "object",
      "required": ["harness_valid", "harness_validity_problems", "mutation_gate_passed", "mutation_gate_failures", "baseline_findings"],
      "properties": {
        "harness_valid": { "type": "boolean" },
        "mutation_gate_passed": { "type": ["boolean", "null"] },
        "baseline_findings": { "type": "integer", "minimum": 0 }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "generator_version", "oracle_spec_version", "mutation_set_version", "seed", "cases", "cases_per_boundary", "cases_per_family",
        "cases_per_variant", "corpus_sha256", "adapter_protocol", "adapter_version", "sut", "sut_repository", "sut_commit", "sut_version",
        "harness_version", "harness_commit", "report_schema_version"
      ],
      "properties": {
        "corpus_sha256": { "$ref": "#/$defs/sha256" },
        "sut_commit": { "$ref": "#/$defs/commit" },
        "adapter_protocol": { "const": 1 }
      }
    },
    "control_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control", "evaluation_boundary", "status"],
        "properties": { "evaluation_boundary": { "enum": ["runtime", "component", "N/A"] }, "status": { "enum": ["measured", "N/A"] } }
      }
    },
    "na_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control", "evaluation_boundary", "status", "reason"],
        "additionalProperties": false,
        "properties": {
          "control": { "type": "string" },
          "evaluation_boundary": { "const": "N/A" },
          "status": { "const": "N/A" },
          "reason": { "type": "string" }
        }
      }
    },
    "reason_taxonomy": { "type": "object", "required": ["version", "classes"] },
    "harness_validity": { "type": "object", "required": ["valid", "problems", "corpus_determinism", "golden", "sut_checkout", "sut_self_verification", "observation_determinism"] },
    "oracle_independence_check": { "type": "object", "required": ["ok", "static_dependency_check", "expectations_precomputed_before_sut_run", "expected_never_sent_to_adapter", "stored_expectation_integrity_errors"] },
    "adapter_validation": { "type": "object", "required": ["hello", "cases_sent", "results_received", "adapter_errors", "harness_errors"] },
    "mutation_reachability": { "type": "object", "required": ["all_ok", "mutants"] },
    "runtime_metrics": { "allOf": [{ "$ref": "#/$defs/boundaryMetrics" }, { "properties": { "boundary": { "const": "runtime" } } }] },
    "component_metrics": { "allOf": [{ "$ref": "#/$defs/boundaryMetrics" }, { "properties": { "boundary": { "const": "component" } } }] },
    "statistical_bounds": {
      "type": "object",
      "required": ["disclaimer", "method", "entries"],
      "properties": {
        "disclaimer": { "const": "Confidence bounds are conditional on the declared synthetic corpus sampling model. They are not estimates of the real-world probability that the system will fail in production." },
        "entries": { "type": "array", "items": { "type": "object", "required": ["boundary", "scope", "metric", "k", "n", "observed_rate", "one_sided_95_upper_bound"], "properties": { "boundary": { "$ref": "#/$defs/boundary" } } } }
      }
    },
    "mutation_sensitivity": {
      "type": "object",
      "required": ["executed", "runtime", "component", "by_mutant", "by_family", "witness_cases"],
      "properties": {
        "by_mutant": { "type": "array", "items": { "$ref": "#/$defs/mutantResult" } }
      }
    },
    "findings": { "type": "array" },
    "adapter_errors": { "type": "array", "items": { "$ref": "#/$defs/errorRecord" } },
    "harness_errors": { "type": "array", "items": { "$ref": "#/$defs/errorRecord" } },
    "oracle_limitation": { "const": "The generator, oracle specification and mutation set are human-authored and may share conceptual blind spots. The evaluation demonstrates conformance to the declared evaluation specification, not absolute real-world safety." },
    "limitations": { "type": "array", "items": { "type": "string" }, "minItems": 5 }
  }
}
